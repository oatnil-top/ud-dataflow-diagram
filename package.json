{
  "name": "@oatnil/ud-dataflow-diagram",
  "version": "0.1.0",
  "description": "The dataflow diagram editor from UnDercontrol — a React component library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oatnil-top/ud-dataflow-diagram.git"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*",
    "!src/test",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.10.0",
    "i18next": "^25.6.1",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.4",
    "zustand": "^5.0.8"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@xyflow/react": "12.10.0",
    "i18next": "25.6.1",
    "jsdom": "^27.0.0",
    "lucide-react": "0.553.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "16.2.4",
    "tailwindcss": "4.1.17",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "wrangler": "4.127.1",
    "zustand": "5.0.8"
  },
  "overrides": {
    "csstype": "3.1.3"
  }
}
